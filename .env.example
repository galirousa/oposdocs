# Copy to .env and fill in real values. Never commit .env.
# Read by django-environ. Every setting the app needs comes from here —
# the app writes nothing to local disk and reads no config file.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dummy-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
LANGUAGE_CODE=es-es
TIME_ZONE=Europe/Madrid

# --- Database -------------------------------------------------------------
POSTGRES_DB=opos
POSTGRES_USER=opos
POSTGRES_PASSWORD=dummy-password
DATABASE_URL=postgres://opos:dummy-password@postgres:5432/opos

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (S3-compatible) ---------------------------------------
# Local development runs MinIO (see docker-compose.yml); production runs
# Garage at http://garage:3900 (see docker-compose.prod.yml).
AWS_ACCESS_KEY_ID=dummy-access-key
AWS_SECRET_ACCESS_KEY=dummy-secret-key
AWS_STORAGE_BUCKET_NAME=opos-documents
AWS_S3_ENDPOINT_URL=http://minio:9000
# Endpoint the *browser* reaches for presigned URLs (empty = same as above).
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=garage
# Public base URL documents are served from (CDN in production).
AWS_S3_CUSTOM_DOMAIN=
# Expiry in seconds for presigned URLs of non-public documents.
PRESIGNED_URL_EXPIRY=900

# --- Search ---------------------------------------------------------------
# postgres | meilisearch
SEARCH_BACKEND=postgres

# --- Email (external provider; never send from the server directly) -------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp-relay.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=dummy-user
EMAIL_HOST_PASSWORD=dummy-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# --- Document pipeline ----------------------------------------------------
# Empty in local development (no clamav container; the scan step logs a
# warning and continues). Set to "clamav" in production.
CLAMAV_HOST=
CLAMAV_PORT=3310
OCR_LANGUAGE=spa
# Documents longer than this are not sent to OCR.
OCR_MAX_PAGES=300

# --- Crawlers and indexing ------------------------------------------------
# False on staging: robots.txt then disallows everything. True here so the
# full crawler policy is visible in local development.
ALLOW_INDEXING=True

# --- Error tracking (GlitchTip, Sentry-compatible) ------------------------
SENTRY_DSN=

# --- Advertising ----------------------------------------------------------
ADSENSE_CLIENT_ID=
ADS_ENABLED=False

# --- Cloudflare Tunnel ----------------------------------------------------
# Token from Cloudflare Zero Trust > Networks > Tunnels (the tunnel's own
# token, not your account API key). cloudflared authenticates outbound with
# it, so no inbound port needs to be open on the server.
CLOUDFLARE_TUNNEL_TOKEN=
# Public domain Caddy serves behind the tunnel (apex, no scheme). Used by
# docker-compose.prod.yml and docker/caddy/Caddyfile.
SITE_DOMAIN=example.com
